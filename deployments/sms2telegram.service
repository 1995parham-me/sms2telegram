[Unit]
Description=Forward the 4G dongle's SMS inbox to Telegram
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# The config holds the bot token: keep it root-only (0600) and hand it to the
# dynamic user as a credential.
LoadCredential=config.toml:/etc/sms2telegram/config.toml
ExecStart=/usr/local/bin/sms2telegram --config %d/config.toml serve
Environment=SMS2TELEGRAM_FORWARDER__STATE_FILE=/var/lib/sms2telegram/state.json
Restart=always
RestartSec=10
DynamicUser=yes
StateDirectory=sms2telegram
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
